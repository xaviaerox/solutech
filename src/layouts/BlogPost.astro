---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title} description={frontmatter.description} page="post">
    <Navbar activePage="blog" />

    <main class="pt-32 pb-20">
        <article class="max-w-3xl mx-auto px-6">
            <header class="mb-12 reveal">
                <a href="/blog" class="inline-flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-widest mb-8 hover:translate-x-[-4px] transition-transform">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                    Volver al Blog
                </a>
                <div class="text-primary font-black tracking-[0.3em] uppercase text-[10px] mb-4">{frontmatter.tag}</div>
                <h1 class="text-4xl md:text-5xl font-bold tracking-tighter leading-tight mb-6">{frontmatter.title}</h1>
                <div class="flex items-center gap-6 text-white/30 text-xs uppercase tracking-widest font-bold">
                    <span>{frontmatter.date}</span>
                    <span>{frontmatter.readTime} de lectura</span>
                </div>
            </header>

            <div class="relative rounded-[40px] overflow-hidden mb-16 reveal h-[400px]">
                <img src={frontmatter.image} alt={frontmatter.title} class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            </div>

            <div class="prose prose-invert prose-orange max-w-none reveal font-light leading-relaxed text-lg text-white/60">
                <slot />
            </div>

            <!-- CTA final -->
            <div class="mt-20 p-12 glass rounded-[40px] border border-primary/20 bg-primary/5 reveal">
                <h3 class="text-2xl font-bold mb-4 tracking-tight">¿Tu infraestructura aguantaría un ataque mañana?</h3>
                <p class="text-white/50 mb-8 font-light leading-relaxed">Hacemos un diagnóstico gratuito de tu situación IT. Sin tecnicismos y con soluciones reales.</p>
                <a href="/soporte" class="btn-primary inline-block text-sm">Solicitar diagnóstico gratuito →</a>
            </div>
        </article>
    </main>

    <Footer />
</Layout>

<style is:global>
    .prose h2 { @apply text-white font-bold text-3xl mt-16 mb-6 tracking-tight; }
    .prose h3 { @apply text-white font-bold text-xl mt-12 mb-4 tracking-tight; }
    .prose p { @apply mb-6; }
    .prose strong { @apply text-white font-bold; }
    .prose ul { @apply list-disc list-inside space-y-3 mb-8 text-white/40; }
    .prose blockquote { @apply border-l-4 border-primary pl-6 py-2 italic text-white/80 bg-white/5 rounded-r-xl mb-8; }
</style>

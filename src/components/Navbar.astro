---
const { activePage = "index" } = Astro.props;

const navLinks = [
  { href: "/", label: "Inicio", id: "index" },
  { href: "/servicios", label: "Planes", id: "servicios" },
  { href: "/nosotros", label: "Sobre Mí", id: "nosotros" },
  { href: "/blog", label: "Blog", id: "blog" },
  { href: "/soporte", label: "Contacto", id: "soporte" },
];
---

<nav id="main-nav">
    <div class="fixed top-0 left-0 w-full z-[100] px-4 py-6" id="nav-wrapper" style="padding-top: 24px;">
        <div class="max-w-7xl mx-auto glass rounded-[32px] px-8 py-4 flex items-center justify-between shadow-2xl">
            <a href="/" class="flex items-center gap-3 group">
                <img src="/assets/img/ICO.png" alt="Solutech Logo" class="h-8 w-auto nav-logo-img">
                <div class="flex flex-col">
                    <span class="text-white font-black tracking-tighter text-xl leading-none group-hover:text-orange-500 transition-colors">SOLUTECH</span>
                    <span class="text-[8px] text-white/20 uppercase tracking-[0.4em] font-bold mt-0.5">Especialistas IT</span>
                </div>
            </a>
            <div class="hidden md:flex items-center gap-10">
                {navLinks.map(link => (
                    <a href={link.href} class={`text-[11px] font-black uppercase tracking-[0.2em] transition-colors ${activePage === link.id ? 'text-orange-500' : 'text-white/40 hover:text-white'}`}>
                        {link.label}
                    </a>
                ))}
            </div>
            <div class="flex items-center gap-4">
                <a href="/soporte" class="hidden lg:block btn-primary">Cita Previa</a>
                <button id="nav-mobile-btn" class="md:hidden text-white p-2" aria-label="Abrir menú">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/></svg>
                </button>
            </div>
        </div>
        
        <!-- Menú Móvil -->
        <div id="nav-mobile" class="hidden mt-3 glass rounded-[28px] p-8 flex flex-col gap-6 md:hidden shadow-2xl">
            {navLinks.map(link => (
                <a href={link.href} class={`text-xl font-black ${activePage === link.id ? 'text-orange-500' : 'text-white'}`}>
                    {link.label}
                </a>
            ))}
            <a href="/soporte" class="btn-primary text-center mt-2">Cita Previa</a>
        </div>
    </div>
</nav>

<script>
    const btn = document.getElementById('nav-mobile-btn');
    const mobile = document.getElementById('nav-mobile');
    if (btn && mobile) {
        btn.addEventListener('click', () => {
            mobile.classList.toggle('hidden');
        });
    }

    const navWrapper = document.getElementById('nav-wrapper');
    if (navWrapper) {
        window.addEventListener('scroll', () => {
            navWrapper.style.paddingTop = window.scrollY > 20 ? '12px' : '24px';
        }, { passive: true });
    }
</script>

<style>
    .nav-logo-img { height: 32px !important; width: auto !important; }
</style>

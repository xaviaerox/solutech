---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SOLUTECH } from '../data/SOLUTECH.js';

const founder = SOLUTECH.founder;
---

<Layout title="Sobre Mí" page="nosotros">
    <Navbar activePage="nosotros" />

    <main class="pt-36 max-w-7xl mx-auto px-6 pb-24">

        <!-- Header -->
        <div class="mb-20 reveal">
            <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">Quién está detrás</span>
            <h1 class="text-5xl md:text-6xl font-bold mt-4 tracking-tight leading-tight">
                No es una empresa.<br>
                <span class="text-orange-500 italic">Es una persona.</span>
            </h1>
        </div>

        <!-- Founder + Values -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start mb-24">
            <!-- Card -->
            <div class="glass p-10 rounded-[40px] reveal">
                <div class="flex items-center gap-6 mb-8">
                    <img src="/assets/img/xavi-alonso.jpg" alt="Xavi Alonso — Fundador de Solutech"
                         class="w-20 h-20 rounded-full object-cover shadow-xl border-2 border-orange-500/30">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight">{founder.name}</h2>
                        <p class="text-orange-500 text-sm font-medium mt-0.5">{founder.role}</p>
                    </div>
                </div>
                <p class="text-white/50 leading-relaxed font-light text-sm">
                    {founder.bio}
                </p>
            </div>
            <!-- Values -->
            <div class="reveal">
                <h3 class="text-2xl font-bold mb-8 tracking-tight">Mi manera de trabajar</h3>
                <ul class="space-y-4">
                    {founder.values.map(val => (
                        <li class="flex items-start gap-4 group">
                            <div class="w-6 h-6 rounded-lg bg-orange-500/10 flex items-center justify-center text-orange-500 text-xs font-bold mt-1 group-hover:bg-orange-500 group-hover:text-black transition-colors">
                                {founder.values.indexOf(val) + 1}
                            </div>
                            <p class="text-white/50 text-sm leading-relaxed font-light">{val}</p>
                        </li>
                    ))}
                </ul>
                <div class="mt-10">
                    <a href="/soporte" class="btn-primary inline-block">Hablar directamente con Xavi →</a>
                </div>
            </div>
        </div>

        <!-- Methodology -->
        <div class="mb-24">
            <div class="mb-12 reveal">
                <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">Metodología</span>
                <h2 class="text-4xl font-bold mt-3 tracking-tighter">Cómo trabajo contigo</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 reveal-group">
                <div class="glass p-8 rounded-[28px]">
                    <div class="text-3xl font-black text-orange-500/30 mb-4">01</div>
                    <h3 class="font-bold mb-2">Auditoría Real</h3>
                    <p class="text-white/40 text-sm leading-relaxed">No solo miro. Analizo el tráfico, busco cuellos de botella en el hardware y verifico la integridad de tus copias. Diagnóstico técnico real.</p>
                </div>
                <div class="glass p-8 rounded-[28px]">
                    <div class="text-3xl font-black text-orange-500/30 mb-4">02</div>
                    <h3 class="font-bold mb-2">Diseño de Sistemas</h3>
                    <p class="text-white/40 text-sm leading-relaxed">Propongo soluciones basadas en la estabilidad. No instalo software que no necesites. Monto infraestructuras que aguantan el día a día.</p>
                </div>
                <div class="glass p-8 rounded-[28px]">
                    <div class="text-3xl font-black text-orange-500/30 mb-4">03</div>
                    <h3 class="font-bold mb-2">Puesta a Punto</h3>
                    <p class="text-white/40 text-sm leading-relaxed">Ejecuto la migración o el despliegue de forma quirúrgica. El objetivo es que el lunes a las 9:00 todo funcione como si nada hubiera cambiado.</p>
                </div>
                <div class="glass p-8 rounded-[28px]">
                    <div class="text-3xl font-black text-orange-500/30 mb-4">04</div>
                    <h3 class="font-bold mb-2">Monitorización</h3>
                    <p class="text-white/40 text-sm leading-relaxed">Estoy ahí antes de que lo notes. Monitorizo proactivamente tus sistemas críticos para intervenir antes de que se conviertan en una avería.</p>
                </div>
            </div>
        </div>

    </main>

    <Footer />
</Layout>

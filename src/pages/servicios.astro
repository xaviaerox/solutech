---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SOLUTECH } from '../data/SOLUTECH.js';

const pricing = SOLUTECH.pricing;
---

<Layout title="Planes y Servicios" page="servicios">
    <Navbar activePage="servicios" />

    <main class="pt-36">
        <!-- ══ HEADER ═════════════════════════════════════════ -->
        <section class="max-w-7xl mx-auto px-6 pb-16 reveal">
            <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">Modelos de Acompañamiento</span>
            <h1 class="text-5xl md:text-6xl font-bold mt-4 tracking-tighter leading-tight">
                Tu infraestructura bajo control.<br>
                <span class="text-orange-500">Sin sorpresas.</span>
            </h1>
            <p class="text-white/40 mt-6 max-w-2xl text-lg leading-relaxed font-light">
                No vendemos horas de técnicos. Vendemos tranquilidad operativa y continuidad de negocio mediante gestión proactiva.
            </p>
        </section>

        <!-- ══ PRICING GRID ═══════════════════════════════════ -->
        <section class="max-w-7xl mx-auto px-6 pb-32">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {pricing.map(plan => (
                    <div class={`glass p-10 rounded-[40px] border ${plan.highlight ? 'border-orange-500' : 'border-white/5'} flex flex-col relative overflow-hidden card-hover reveal`}>
                        {plan.highlight && <div class="absolute top-0 right-0 bg-orange-500 text-black font-black text-[9px] px-6 py-2 rounded-bl-2xl uppercase tracking-widest">{plan.badge}</div>}
                        <p class="text-white/30 text-xs mb-4 uppercase tracking-widest">{plan.target}</p>
                        <h3 class="text-2xl font-bold mb-2">{plan.name}</h3>
                        <div class="flex items-baseline gap-1 mb-8">
                            <span class="text-4xl font-black">{plan.price}</span>
                            <span class="text-white/30 text-sm italic">{plan.period}</span>
                        </div>
                        <ul class="space-y-3 mb-8 flex-grow">
                            {plan.features.map(f => (
                                <li class="flex items-start gap-3 text-sm text-white/60 font-light">
                                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                    </svg>
                                    <Fragment set:html={f} />
                                </li>
                            ))}
                        </ul>
                        <a href="/soporte" class={`${plan.highlight ? 'btn-primary w-full text-center' : 'glass border border-white/10 hover:bg-white/5 font-bold text-white text-sm py-4 rounded-xl text-center block transition-all'}`}>
                            {plan.cta}
                        </a>
                    </div>
                ))}
            </div>
        </section>

        <!-- ══ FAQ CTA ════════════════════════════════════════ -->
        <section class="max-w-4xl mx-auto px-6 pb-24 text-center reveal">
            <div class="glass p-12 rounded-[40px]">
                <h2 class="text-3xl font-bold mb-4 tracking-tighter">¿Tienes dudas sobre qué plan necesitas?</h2>
                <p class="text-white/40 mb-8 max-w-xl mx-auto text-sm leading-relaxed">
                    Primera consulta sin coste. Te explicamos qué necesita tu empresa y qué plan se adapta mejor — sin tecnicismos.
                </p>
                <a href="/soporte" class="btn-primary inline-block">Consulta gratuita →</a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

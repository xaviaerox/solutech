---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title="Blog IT y Estrategia" page="blog">
    <Navbar activePage="blog" />

    <main class="pt-40 pb-24">
        <section class="max-w-7xl mx-auto px-6">
            <div class="mb-20 reveal text-center">
                <span class="text-primary font-black tracking-[0.3em] uppercase text-[10px]">Cultura Tecnológica</span>
                <h1 class="text-5xl md:text-6xl font-bold mt-4 tracking-tighter">Bitácora de <span class="text-primary">Continuidad.</span></h1>
                <p class="text-white/40 max-w-2xl mx-auto mt-6 text-lg font-light leading-relaxed">
                    Análisis, consejos y noticias sobre ciberseguridad, gestión IT y el ecosistema empresarial del sureste.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 reveal-group">
                {sortedPosts.map(post => (
                    <a href={`/blog/${post.id}`} class="glass rounded-[32px] overflow-hidden card-hover flex flex-col group">
                        <div class="relative h-56 overflow-hidden">
                            <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100">
                            <div class="absolute top-6 left-6">
                                <span class="bg-primary text-black font-black text-[9px] px-4 py-1.5 rounded-full uppercase tracking-widest">{post.data.tag}</span>
                            </div>
                        </div>
                        <div class="p-8 flex flex-col flex-grow">
                            <div class="flex items-center gap-4 text-white/20 text-[10px] uppercase tracking-widest font-bold mb-4">
                                <span>{post.data.date}</span>
                                <span class="w-1 h-1 rounded-full bg-white/10"></span>
                                <span>{post.data.readTime}</span>
                            </div>
                            <h2 class="text-xl font-bold mb-4 tracking-tight group-hover:text-primary transition-colors leading-tight">{post.data.title}</h2>
                            <p class="text-white/40 text-sm font-light leading-relaxed line-clamp-3 mb-8">{post.data.description}</p>
                            <div class="mt-auto flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
                                Leer artículo completo
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </main>

    <Footer />
</Layout>

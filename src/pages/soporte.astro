---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto & Soporte" page="soporte">
    <Navbar activePage="soporte" />

    <main class="pt-40">
        <section class="max-w-7xl mx-auto px-6 pb-24">

            <!-- Header -->
            <div class="mb-16 reveal">
                <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">Contacto Directo</span>
                <h1 class="text-5xl md:text-6xl font-bold mt-4 tracking-tight">Háblame de <span class="text-orange-500 italic">tu caso.</span></h1>
                <p class="text-white/40 max-w-xl mt-6 text-lg font-light leading-relaxed">
                    Sin formularios interminables. Elige cómo quieres contactarme y te respondo yo directamente.
                </p>
            </div>

            <!-- 3 Canales de contacto -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20 reveal-group">

                <!-- Canal 1: Agendar llamada -->
                <div class="glass p-8 rounded-[32px] border border-white/5 flex flex-col justify-between group hover:border-orange-500/20 transition-all">
                    <div>
                        <div class="w-12 h-12 bg-orange-500/10 rounded-xl flex items-center justify-center text-orange-500 mb-8 shadow-lg">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <h3 class="text-xl font-bold mb-4 tracking-tight">Agendar Llamada</h3>
                        <p class="text-sm text-white/40 mb-8 font-light">Reserva 30 minutos conmigo. Te escucho, evalúo tu situación y te digo honestamente si puedo ayudarte. Sin coste, sin compromiso.</p>
                    </div>
                    <a href="https://wa.me/34684248465?text=Hola%20Xavi%2C%20quiero%20agendar%20una%20llamada" target="_blank" rel="noopener"
                       class="orange-gradient w-full py-4 rounded-xl font-bold text-white text-center shadow-xl shadow-orange-500/20 hover:scale-[1.02] transition-all text-sm block">
                        Elegir Fecha y Hora
                    </a>
                </div>

                <!-- Canal 2: WhatsApp -->
                <div class="glass p-8 rounded-[32px] border border-white/5 flex flex-col justify-between group hover:border-emerald-500/20 transition-all">
                    <div>
                        <div class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center text-emerald-500 mb-8 shadow-lg">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884z"/></svg>
                        </div>
                        <h3 class="text-xl font-bold mb-4 tracking-tight">WhatsApp Directo</h3>
                        <p class="text-sm text-white/40 mb-8 font-light">Para consultas rápidas o urgencias. Respondo yo directamente — no un bot, no un equipo de soporte. Yo.</p>
                    </div>
                    <a href="https://wa.me/34684248465" target="_blank" rel="noopener"
                       class="bg-emerald-600/20 border border-emerald-500/30 w-full py-4 rounded-xl font-bold text-center text-emerald-400 hover:bg-emerald-600 hover:text-white transition-all text-sm block">
                        Abrir WhatsApp
                    </a>
                </div>

                <!-- Canal 3: Soporte Remoto -->
                <div class="glass p-8 rounded-[32px] border border-white/5 flex flex-col justify-between group hover:border-blue-500/20 transition-all">
                    <div>
                        <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center text-blue-400 mb-8 shadow-lg">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        </div>
                        <h3 class="text-xl font-bold mb-4 tracking-tight">Soporte Remoto</h3>
                        <p class="text-sm text-white/40 mb-8 font-light">¿Ya eres cliente? Descarga la herramienta de acceso remoto para que pueda intervenir de forma segura en tu equipo.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="https://anydesk.com/download" target="_blank" rel="noopener"
                           class="bg-blue-600/10 border border-blue-500/20 w-1/2 py-4 rounded-xl font-bold text-center text-blue-400 hover:bg-white/5 transition-all text-xs">AnyDesk</a>
                        <a href="https://www.teamviewer.com/download" target="_blank" rel="noopener"
                           class="bg-blue-600/10 border border-blue-500/20 w-1/2 py-4 rounded-xl font-bold text-center text-blue-400 hover:bg-white/5 transition-all text-xs">TeamViewer</a>
                    </div>
                </div>
            </div>

            <!-- Formulario de contacto -->
            <div id="reservas" class="mb-24 reveal">
                <div class="mb-10">
                    <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">O si lo prefieres</span>
                    <h2 class="text-3xl font-bold mt-3 tracking-tight">Escríbeme aquí</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl">
                    <input type="text" id="contact-name" placeholder="Tu nombre *" required
                        class="glass border border-white/10 rounded-xl px-6 py-4 outline-none focus:border-orange-500 transition-all text-white text-sm placeholder-white/20">
                    <input type="email" id="contact-email" placeholder="Tu email *" required
                        class="glass border border-white/10 rounded-xl px-6 py-4 outline-none focus:border-orange-500 transition-all text-white text-sm placeholder-white/20">
                    <input type="tel" id="contact-phone" placeholder="Teléfono (opcional)"
                        class="glass border border-white/10 rounded-xl px-6 py-4 outline-none focus:border-orange-500 transition-all text-white text-sm placeholder-white/20">
                    <select id="contact-need" required
                        class="glass border border-white/10 rounded-xl px-6 py-4 outline-none focus:border-orange-500 transition-all text-white text-sm bg-transparent">
                        <option value="" disabled selected class="bg-[#0a0a0a]">¿Qué necesitas? *</option>
                        <option value="Soporte técnico puntual" class="bg-[#0a0a0a]">Soporte técnico puntual</option>
                        <option value="Plan de mantenimiento"   class="bg-[#0a0a0a]">Contratar un plan de mantenimiento</option>
                        <option value="Seguridad / RGPD"        class="bg-[#0a0a0a]">Seguridad de datos / RGPD</option>
                        <option value="Copias de seguridad"     class="bg-[#0a0a0a]">Copias de seguridad</option>
                        <option value="Consultoría"             class="bg-[#0a0a0a]">Consultoría / Asesoramiento IT</option>
                        <option value="Otro"                    class="bg-[#0a0a0a]">Otra cosa</option>
                    </select>
                    <textarea id="contact-message" placeholder="Explícame brevemente tu situación..." rows="4" required
                        class="glass border border-white/10 rounded-xl px-6 py-4 outline-none focus:border-orange-500 transition-all text-white text-sm md:col-span-2 resize-none placeholder-white/20"></textarea>
                    <div class="md:col-span-2">
                        <button type="button" id="contact-btn"
                            class="btn-primary px-10 py-4 text-sm shadow-xl shadow-orange-500/20 hover:scale-[1.02]">
                            Enviar Consulta
                        </button>
                        <p class="text-[10px] text-white/20 mt-3 uppercase tracking-widest">Te respondo personalmente en menos de 24h</p>
                        <p id="form-status" class="text-sm mt-3 hidden"></p>
                    </div>
                </div>
            </div>

            <!-- FAQ -->
            <div class="mb-12 reveal">
                <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">Preguntas Frecuentes</span>
                <h2 class="text-3xl font-bold mt-3 tracking-tight">Antes de contactar</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 reveal-group">
                <div class="glass p-6 rounded-2xl border border-white/5">
                    <h4 class="font-bold text-sm mb-2">¿La consulta inicial es gratis?</h4>
                    <p class="text-white/40 text-xs font-light leading-relaxed">Sí. La primera conversación es siempre gratuita. Te escucho, evalúo tu caso y te digo honestamente si puedo ayudarte y cuánto costaría.</p>
                </div>
                <div class="glass p-6 rounded-2xl border border-white/5">
                    <h4 class="font-bold text-sm mb-2">¿Cuánto tardas en responder?</h4>
                    <p class="text-white/40 text-xs font-light leading-relaxed">Si eres cliente con plan activo, menos de 4 horas. Para consultas nuevas, máximo 24 horas en días laborables.</p>
                </div>
                <div class="glass p-6 rounded-2xl border border-white/5">
                    <h4 class="font-bold text-sm mb-2">¿Cuál es tu alcance de servicio?</h4>
                    <p class="text-white/40 text-xs font-light leading-relaxed">Soporte presencial en el Levante y remoto avanzado a nivel nacional. La tecnología no entiende de fronteras, y mi capacidad de respuesta es la misma estés donde estés.</p>
                </div>
                <div class="glass p-6 rounded-2xl border border-white/5">
                    <h4 class="font-bold text-sm mb-2">¿Me puedo dar de baja cuando quiera?</h4>
                    <p class="text-white/40 text-xs font-light leading-relaxed">Sí, sin permanencia. Si no estás contento, te vas — así de simple. Prefiero ganarte cada mes que retenerte por contrato.</p>
                </div>
            </div>

        </section>
    </main>

    <Footer />

    <script is:inline>
    async function handleContactSubmit() {
        const btn     = document.getElementById('contact-btn');
        const status  = document.getElementById('form-status');
        const name    = document.getElementById('contact-name').value.trim();
        const email   = document.getElementById('contact-email').value.trim();
        const phone   = document.getElementById('contact-phone').value.trim();
        const need    = document.getElementById('contact-need').value;
        const message = document.getElementById('contact-message').value.trim();

        if (!name || !email || !need || !message) {
            status.textContent = 'Por favor rellena todos los campos obligatorios.';
            status.className = 'text-sm mt-3 text-orange-400';
            status.classList.remove('hidden');
            return;
        }

        const BREVO_FORM_URL = 'https://ca6f8e13.sibforms.com/serve/MUIFAFR0CxQ9-93oNPTzB8_3dtGUfYHfM4PvY5_T6vfsc93NWU6n1v4Q2cS4HXXUt8fxHHF-HKWqKxeW_XaExxcmROgfVB3fnijF1ejfbYXXUH0MNnCHu7em8a88ERoEcjapuUav1cI2O3N7r7oJAUK7tPEG-J7f82IHkn7Cm5ZLjM-vDUUuptAd0zUZNy0TdlcymdGQIwU9nvB7gg=='; 

        btn.disabled = true;
        btn.textContent = 'Enviando...';
        status.textContent = 'Procesando tu solicitud...';
        status.className = 'text-sm mt-3 text-white/40';
        status.classList.remove('hidden');

        try {
            const formData = new FormData();
            formData.append('EMAIL', email);
            formData.append('NOMBRE', name);
            formData.append('TELEFONO', phone);
            formData.append('NECESIDAD', need);
            formData.append('MENSAJE', message);
            
            await fetch(BREVO_FORM_URL, {
                method: 'POST',
                body: formData,
                mode: 'no-cors' 
            });

            status.textContent = '¡Gracias! He recibido tu consulta. Te responderé personalmente muy pronto.';
            status.className = 'text-sm mt-3 text-emerald-400';
            btn.textContent = 'Consulta Enviada';
            
            document.querySelectorAll('#reservas input, #reservas textarea').forEach(el => el.value = '');
            document.getElementById('contact-need').value = '';

        } catch (error) {
            console.error('Error:', error);
            status.textContent = 'Hubo un error al enviar. Por favor, inténtalo de nuevo o escríbeme por WhatsApp.';
            status.className = 'text-sm mt-3 text-orange-400';
            btn.disabled = false;
            btn.textContent = 'Reintentar Envío';
        }
    }

    document.getElementById('contact-btn')?.addEventListener('click', handleContactSubmit);
    </script>
</Layout>

<style>
    .orange-gradient {
        background: linear-gradient(135deg, #ff6b00 0%, #e65100 100%);
    }
</style>

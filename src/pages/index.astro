---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SOLUTECH } from '../data/SOLUTECH.js';

const services = SOLUTECH.services;
const portfolio = SOLUTECH.portfolio;
---

<Layout title="Soporte IT y MSP para Empresas" page="index">
    <Navbar activePage="index" />

    <main>
        <!-- ══ HERO ═══════════════════════════════════════════ -->
        <section class="relative min-h-screen flex items-center overflow-hidden">
            <div class="absolute inset-0 z-0">
                <img
                    src="/assets/img/hero-datacenter.png"
                    alt="Infraestructura IT profesional"
                    class="w-full h-full object-cover hero-reveal"
                    style="transform: scale(1.1);"
                    loading="eager"
                >
                <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-black/40"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30"></div>
            </div>

            <div class="absolute top-1/3 left-1/4 w-[500px] h-[500px] bg-orange-500/10 rounded-full blur-[140px] pointer-events-none z-0"></div>

            <div class="relative z-10 max-w-7xl mx-auto px-6 pt-36 pb-24 w-full">
                <div class="max-w-3xl">
                    <div class="reveal space-y-8">
                        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 text-orange-400 border border-orange-500/25 text-[10px] font-bold tracking-[0.2em] uppercase">
                            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 status-pulse"></span>
                            MSP · Outsourcing IT Premium
                        </span>
                        <h1 class="text-5xl lg:text-7xl font-bold leading-[1.02] tracking-tighter">
                            Tu IT en manos<br>de alguien que<br>
                            <span class="text-orange-500">responde.</span>
                        </h1>
                        <p class="text-lg text-white/50 max-w-xl leading-relaxed font-light">
                            Soporte técnico proactivo, ciberseguridad y continuidad de negocio para pymes que no pueden permitirse parones. Sin call centers. Sin esperas. Sin excusas.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4 pt-2">
                            <a href="/soporte" class="btn-primary text-sm px-10 py-4">
                                Diagnóstico gratuito →
                            </a>
                            <a href="/servicios" class="glass border border-white/10 hover:bg-white/5 px-10 py-4 rounded-xl font-bold text-sm text-white transition-all text-center">
                                Ver planes y precios
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="absolute bottom-0 left-0 right-0 z-10">
                <div class="max-w-7xl mx-auto px-6 pb-12">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 reveal-group">
                        <div class="glass px-6 py-4 rounded-2xl text-center border border-white/5">
                            <p class="text-2xl font-black text-orange-500">+50</p>
                            <p class="text-white/30 text-[10px] uppercase tracking-widest mt-1">Empresas activas</p>
                        </div>
                        <div class="glass px-6 py-4 rounded-2xl text-center border border-white/5">
                            <p class="text-2xl font-black text-orange-500">&lt;2h</p>
                            <p class="text-white/30 text-[10px] uppercase tracking-widest mt-1">Tiempo de respuesta</p>
                        </div>
                        <div class="glass px-6 py-4 rounded-2xl text-center border border-white/5">
                            <p class="text-2xl font-black text-orange-500">99%</p>
                            <p class="text-white/30 text-[10px] uppercase tracking-widest mt-1">Uptime garantizado</p>
                        </div>
                        <div class="glass px-6 py-4 rounded-2xl text-center border border-white/5">
                            <p class="text-2xl font-black text-orange-500">0€</p>
                            <p class="text-white/30 text-[10px] uppercase tracking-widest mt-1">Primera consulta</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══ SERVICES ════════════════════════════════════════ -->
        <section class="max-w-7xl mx-auto px-6 py-28">
            <div class="mb-16 reveal">
                <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">Qué hacemos</span>
                <h2 class="text-4xl md:text-5xl font-bold mt-3 tracking-tighter">
                    Un departamento IT completo.<br>
                    <span class="text-orange-500">A fracción del coste.</span>
                </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {services.map(s => (
                    <div class="glass p-8 rounded-[28px] card-hover reveal">
                        <div class={`w-14 h-14 rounded-2xl ${s.color} flex items-center justify-center mb-6`}>
                            <Fragment set:html={s.icon} />
                        </div>
                        <h3 class="text-lg font-bold mb-2">{s.title}</h3>
                        <p class="text-white/40 text-sm leading-relaxed font-light">{s.description}</p>
                    </div>
                ))}
            </div>
        </section>

        <!-- ══ PORTFOLIO ══════════════════════════════════════ -->
        <section class="max-w-7xl mx-auto px-6 pb-28">
            <div class="mb-16 reveal">
                <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">Casos reales</span>
                <h2 class="text-4xl md:text-5xl font-bold mt-3 tracking-tighter">
                    Proyectos que hemos ejecutado.<br>
                    <span class="text-orange-500">Sin venderte humo.</span>
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {portfolio.map(p => (
                    <div class="glass rounded-[28px] overflow-hidden card-hover reveal">
                        <div class="relative h-48 overflow-hidden">
                            <img src={p.image} alt={p.title} class="w-full h-full object-cover opacity-70 hover:opacity-90 transition-opacity duration-500">
                            <div class="absolute top-4 left-4 flex gap-2">
                                <span class="text-[9px] font-black uppercase tracking-widest bg-orange-500 text-white px-3 py-1 rounded-full">{p.tag}</span>
                                <span class="text-[9px] font-black uppercase tracking-widest bg-white/10 text-white/70 px-3 py-1 rounded-full">{p.label}</span>
                            </div>
                        </div>
                        <div class="p-7">
                            <p class="text-white/30 text-xs uppercase tracking-widest mb-2">{p.client}</p>
                            <h3 class="text-lg font-bold mb-3 tracking-tight">{p.title}</h3>
                            <p class="text-white/40 text-sm leading-relaxed">{p.description}</p>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- ══ SPLIT SECTION ═════════════════════════════════ -->
        <section class="max-w-7xl mx-auto px-6 pb-28">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="relative rounded-[40px] overflow-hidden reveal" style="height: 480px;">
                    <img src="/assets/img/xavi-alonso.jpg" alt="Xavi Alonso" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                    <div class="absolute bottom-8 left-8">
                        <p class="font-bold text-lg">Xavi Alonso</p>
                        <p class="text-orange-500 text-sm">Fundador & Técnico Superior de Sistemas</p>
                    </div>
                </div>
                <div class="reveal space-y-6">
                    <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">Por qué funciona</span>
                    <h2 class="text-4xl font-bold tracking-tighter leading-tight">
                        No tienes un ticket.<br>Tienes una persona.
                    </h2>
                    <p class="text-white/50 leading-relaxed font-light">
                        Cuando hay un problema, no abres una incidencia en un sistema. Me escribes directamente a mí. Yo lo resuelvo. Sin escalados, sin departamentos, sin "vamos a registrar el caso".
                    </p>
                    <p class="text-white/50 leading-relaxed font-light">
                        Eso es lo que hace diferente trabajar con un MSP de una sola persona que se juega su nombre en cada intervención.
                    </p>
                    <div class="flex gap-4 pt-4">
                        <a href="/nosotros" class="btn-primary text-sm">Conoce mi perfil</a>
                        <a href="/soporte"  class="glass border border-white/10 hover:bg-white/5 px-7 py-3 rounded-xl font-bold text-sm text-white transition-all">Hablar ahora</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══ FINAL CTA ═══════════════════════════════════════ -->
        <section class="max-w-4xl mx-auto px-6 pb-24 text-center reveal">
            <div class="glass p-16 rounded-[40px] border border-white/5">
                <span class="text-orange-500 font-black tracking-[0.3em] uppercase text-[10px]">Sin compromiso</span>
                <h2 class="text-4xl md:text-5xl font-bold mt-4 mb-6 tracking-tighter">
                    ¿Tu IT bajo control?<br><span class="text-orange-500">Empecemos hoy.</span>
                </h2>
                <p class="text-white/40 text-base mb-10 max-w-xl mx-auto leading-relaxed">
                    Primera consulta gratuita. Sin tecnicismos. Sin compromisos. Solo un diagnóstico honesto de tu situación y qué podemos hacer juntos.
                </p>
                <a href="/soporte" class="btn-primary text-sm px-12 py-5">
                    Solicitar diagnóstico gratuito
                </a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
